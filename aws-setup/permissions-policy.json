{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:*",
        "s3:*",
        "cloudfront:*",
        "lambda:*",
        "apigateway:*",
        "iam:*",
        "logs:*",
        "ssm:GetParameter",
        "ssm:PutParameter",
        "sts:AssumeRole",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
